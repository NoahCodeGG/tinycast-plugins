{
  "name": "noah-tinycast-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "package": "pnpm build && node scripts/package.mjs",
    "package:github": "pnpm build && node scripts/package-github.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "devDependencies": {
    "@raycast/api": "1.93.2",
    "@types/node": "20.8.10",
    "@types/react": "18.3.3",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "typescript": "5.9.3"
  }
}
